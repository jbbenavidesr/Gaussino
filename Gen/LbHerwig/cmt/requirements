package       LbHerwig
version       v5r0

#============================================================================
# Structure, i.e. directories to process. 
#============================================================================
branches      LbHerwig doc cmt src

#============================================================================
# Used packages. 
#============================================================================
include_dirs  $(LBHERWIGROOT)

### NOTE: the order of these use is important 
###       GaussHerwig.exe complains about PHOINI and stops
use  Generators    v*  Gen
use  herwig        v*  LCG_GeneratorsInterfaces
use  jimmy         v*  LCG_GeneratorsInterfaces

use  MCatNLOData   v*        

#============================================================================
# Component and linker library building rule
#============================================================================
library       LbHerwigLib       Lib/utility/*.cpp Lib/herwig/*.F \
                                Lib/jimmy/*.F Lib/mcatnlo/*.F \
                                Lib/mcatnlo/*.f Lib/mcatnlo/*.c
library       LbHerwig          component/*.cpp

#============================================================================
# define component and linker library link options
#============================================================================
apply_pattern component_library library=LbHerwig 
apply_pattern linker_library    library=LbHerwigLib 
apply_pattern library_stamps    library=LbHerwigLib 

macro LbHerwig_fflags "-Wall -fno-second-underscore -fno-automatic" \
      WIN32 ""

