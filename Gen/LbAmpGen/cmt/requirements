package           LbAmpGen
version           v1r0

# Structure, i.e. directories to process. 
#============================================================================
branches          cmt doc src models utils

# Used packages. 
#============================================================================
use  GaudiPolicy  *

include_path      none

# Component library building rule
#============================================================================
library          LbDtoKpipipi_v1    DtoKpipipi_v1.cpp 
library          LbDtopiKpipi_v1    DtopiKpipi_v1.cpp

# define component library link options
#============================================================================
apply_pattern    component_library library=LbDtoKpipipi_v1
apply_pattern    component_library library=LbDtopiKpipi_v1

# Make the C++ source code from the steering files
#============================================================================
private
  action ampgen_source_files "${LBAMPGENROOT}/utils/makeModels.py"
  macro_remove cmt_actions_constituents "ampgen_source_files"
end_private

