package           AmpGen
version           v1r0

# Structure, i.e. directories to process. 
#============================================================================
branches          AmpGen cmt doc src apps models

# Used packages.
#============================================================================
use GaudiPolicy * 
use ROOT        * LCG_Interfaces -no_auto_imports

include_dirs $(AMPGENROOT)

macro_append cppflags " -g -fPIC -Ofast -std=c++14 -fopenmp -Wno-unused-function -Wno-unused-parameter"
macro_append ROOT_linkopts " -lHist -lMatrix -lGraf -lMinuit -lTree -lMathCore -lPhysics"

# Linker library building rule
#============================================================================
library          AmpGen    -import=ROOT ../src/*.cpp 
macro_append AmpGen_use_linkopts " -fopenmp "
apply_pattern    linker_library library=AmpGen

# Executables
#============================================================================
private 
  application                  Generator  -import=ROOT ../apps/Generator.cpp
  application                     Fitter  -import=ROOT ../apps/Fitter.cpp
  application        ConvertToSourceCode  -import=ROOT ../apps/ConvertToSourceCode.cpp

#special linkopts
  macro_append            Generatorlinkopts    "$(use_linkopts) -fopenmp"
  macro_append               Fitterlinkopts    "$(use_linkopts) -fopenmp"
  macro_append  ConvertToSourceCodelinkopts    "$(use_linkopts) -fopenmp"

  macro Generator_dependencies AmpGen
  macro Fitter_dependencies AmpGen
  macro ConvertToSourceCode_dependencies AmpGen
  
end_private



