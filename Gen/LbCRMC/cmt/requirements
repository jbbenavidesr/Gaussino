package  LbCRMC
version  v1r0


# Structure, i.e. directories to process.
#============================================================================
branches        LbCRMC python cmt doc src


# Local include directory (not exported to project).
#============================================================================
include_dirs    $(LBCRMCROOT)


# Used packages.
#============================================================================
use      crmc          v*    LCG_GeneratorsInterfaces
use      Generators    v*    Gen


# Component and linker library building rule
#============================================================================
library       LbCRMCLib    Lib/*.cpp Lib/*.F
library       LbCRMC       component/*.cpp


# Define component and linker library link options
#============================================================================

apply_pattern    component_library   library=LbCRMC
apply_pattern    linker_library      library=LbCRMCLib
apply_pattern    library_stamps      library=LbCRMCLib


# ========================= Install configurable ============================
#apply_pattern install_python_modules


private
macro_append ROOT_linkopts " -lMatrix"
end_private
