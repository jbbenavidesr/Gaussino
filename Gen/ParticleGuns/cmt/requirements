package          ParticleGuns
version          v5r0


# Structure
#============================================================================
branches         ParticleGuns cmt doc src


# Used packages. 
#============================================================================
use GaudiAlg       v*
use GenEvent       v*      Event
use DetDesc        v*      Det
use Generators     v*      Gen

# Export include files
#============================================================================
apply_pattern install_more_includes more=ParticleGuns

# Component library building rule
#============================================================================
library          ParticleGuns    *.cpp

# define component library link options
#============================================================================
apply_pattern    component_library library=ParticleGuns
