package crmc

use LCG_Configuration v*
use LCG_Settings v*


## CRMC Home
macro    crmc_home $(LCG_external)/MCGenerators/crmc/$(crmc_native_version)/$(LCG_system)
#
set CRMCHOME "$(crmc_home)"
#
#
## CRMC tabs files
macro crmc_tabs $(crmc_home)/tabs
set CRMC_TABS "$(crmc_tabs)"
#
#
## Configure the includes
include_path none
include_dirs $(crmc_home)/src
#
#
## Configure linking options
macro crmc_linkopts "-L$(crmc_home)/lib -lCrmcBasic -lHepEvtDummy "
#
#
macro crmc_name "crmc"
# The following 
#path_append LD_LIBRARY_PATH $(crmc_home)/lib
# should be replaced by
apply_pattern set_lib_path




