<extension class="GaudiTest.GaudiExeTest" kind="test">
<argument name="program"><text>gaudirun.py</text></argument>
<argument name="timeout"><integer>600</integer></argument>
<argument name="args"><set>
  <text>../options/gauss_geo_planes.py</text>
</set></argument>
<argument name="validator"><text>
results = [
    "ToolSvc.Plane{}SDet        DEBUG GiGaSensDetTracker::initialize() Sensitive Detector is activated".format(plane_no + 1)
    for plane_no in range(4)
]
for result in results:
    if stdout.find(result) == -1:
        causes.append('One of the plane sens dets were not registered!')
        result['GaudiTest.expected_string'] = result.Quote(result)
</text></argument>
</extension>
