package                        GaussGeo
version                        v1r0

# Structure, i.e. directories to process.
#============================================================================
branches                       cmt doc src GaussGeo

# Used packages.
#============================================================================
use              DetDesc      v*     Det
use              G4readout    v*     Geant4
use              GiGa         v*     Sim

#============== standard includes ===========================================
apply_pattern install_more_includes more=GaussGeo

# Component and linker library building rule
#============================================================================
library       GaussGeo         component/*.cpp

# Define component and linker library link options
#============================================================================
apply_pattern    component_library   library=GaussGeo
