<extension class="GaudiTest.GaudiExeTest" kind="test">
<argument name="program"><text>gaudirun.py</text></argument>
<argument name="timeout"><integer>600</integer></argument>
<argument name="args"><set>
    <text>$GAUSSINOOPTS/General/Events-1.py</text>
    <text>$GAUSSINOOPTS/General/Debug.py</text>
    <text>$GAUSSINOOPTS/General/ConvertEDM.py</text>
    <text>$GAUSSINOOPTS/Simulation/G4EmStandardPhysics.py</text>
    <text>../options/zMax_external_geo.py</text>
</set></argument>
<argument name="validator"><text>
import re
  
# expect more than one particles stored in the north plane (behind zMax)
north_plane_regex = r'Particles=\W*\b(?![1]\b)\d{1,7}\b\W*in\W*NorthPlaneSDet'

# expect exactly one particle stored in the south plane
south_plane_regex = r'Particles=\W*1\W*in\W*SouthPlaneSDet'

if not re.findall(north_plane_regex, stdout):
    causes.append('NorthPlane should store more than one particle!')

if not re.findall(south_plane_regex, stdout):
    causes.append('SouthPlane should store exactly one particle!')

</text></argument>
</extension>
